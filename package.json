{
  "name": "@willbooster/tree-sitter-kotlin",
  "version": "0.0.0-semantically-released",
  "description": "Kotlin grammar for tree-sitter",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "kotlin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tree-sitter-kotlin.git"
  },
  "license": "MIT",
  "author": "WillBooster Inc.",
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "scripts": {
    "build-prebuilds": "prebuildify --napi --strip --name tree-sitter-kotlin",
    "build-wasm": "tree-sitter build --wasm",
    "build/ci": "tree-sitter generate && node-gyp rebuild",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "install": "node-gyp-build",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "release-test": "node node_modules/semantic-release/bin/semantic-release.js --dry-run --plugins @semantic-release/commit-analyzer @semantic-release/release-notes-generator",
    "prestart": "bun run build-wasm",
    "start": "tree-sitter playground",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@willbooster/wb": "22.8.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lefthook": "2.1.14",
    "node-gyp": "13.0.2",
    "prebuildify": "^6.0.1",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
