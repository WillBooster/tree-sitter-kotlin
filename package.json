{
  "name": "@willbooster/tree-sitter-kotlin",
  "version": "0.0.0-semantically-released",
  "description": "Kotlin grammar for tree-sitter",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "kotlin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tree-sitter-kotlin.git"
  },
  "license": "MIT",
  "author": "WillBooster Inc.",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "src/node-types.json",
    "*.wasm"
  ],
  "scripts": {
    "build-wasm": "tree-sitter build --wasm",
    "build/ci": "tree-sitter generate && tree-sitter build --wasm",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "prestart": "bun run build-wasm",
    "start": "tree-sitter playground",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "@willbooster/wb": "22.8.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "tree-sitter-cli": "0.27.0",
    "typescript": "7.0.2",
    "web-tree-sitter": "0.27.0"
  },
  "peerDependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "peerDependenciesMeta": {
    "web-tree-sitter": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
