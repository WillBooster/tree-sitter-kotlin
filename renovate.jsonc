{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // The Wasm tests run on @willbooster/web-tree-sitter, and the Rust tests, the fuzz job, and the CLI that
      // script/fork-cli provides on willbooster-tree-sitter, the same runtime, so they are updated together.
      "matchPackageNames": ["@willbooster/web-tree-sitter", "willbooster-tree-sitter"],
      "groupName": "tree-sitter",
    },
    {
      // Cargo's publish-age gate admits willbooster-tree-sitter only seven days after its release, so the npm runtime
      // released from the same commit, which the preset otherwise exempts, waits as long to keep the grouped update in
      // step. To adopt a release sooner, run `CARGO_RESOLVER_INCOMPATIBLE_PUBLISH_AGE=allow cargo update -p
      // willbooster-tree-sitter` and bump @willbooster/web-tree-sitter to the same version.
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "minimumReleaseAge": "7 days",
    },
  ],
}
