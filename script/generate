#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
mkdir -p .tmp/generation-profiles

examples=$(mktemp "$root/.tmp/generation-profiles/examples.pending.XXXXXX")
trap 'rm -f "$examples"' EXIT
git ls-files -z -- examples > "$examples"

training=(--corpus "$root/test/corpus")
while IFS= read -r -d '' file; do
  training+=("$root/$file")
done < "$examples"

node -e 'const {grammars} = require("./tree-sitter.json"); console.log([...new Set(grammars.map(({path}) => path ?? "."))].sort().join("\n"));' | while IFS= read -r grammar; do
  script/tree-sitter generate "$grammar/grammar.js" --abi 16
  bun script/generateLetterRanges.js
  name=$(node -e 'console.log(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).name)' "$grammar/src/grammar.json")
  profile="$root/.tmp/generation-profiles/$name.json"
  script/tree-sitter profile --grammar-path "$grammar" --output "$profile" "${training[@]}"
  script/tree-sitter generate "$grammar/grammar.js" --abi 16 --profile "$profile"
  bun script/generateLetterRanges.js
done

mv "$examples" "$root/.tmp/generation-profiles/examples.z"
