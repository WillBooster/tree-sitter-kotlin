#!/usr/bin/env node
// Writes src/letter_ranges.h, the non-ASCII code point ranges of the characters that may start (`[\p{L}_]`) and
// continue (`[\p{L}_\p{Nd}]`) an identifier in a string template, for the external scanner. They are copied from the
// character sets that `tree-sitter generate` wrote into src/parser.c for that token, so that both agree on the Unicode
// version.

const fs = require('node:fs');
const path = require('node:path');

const src = path.join(__dirname, '..', 'src');
const parser = fs.readFileSync(path.join(src, 'parser.c'), 'utf8');

function nonAsciiRanges(asciiPrefix, description) {
  const set = new RegExp(
    String.raw`static const TSCharacterRange \w+\[\] = \{\n  ${asciiPrefix.replaceAll(/[{}]/g, '\\$&')}, ([^;]*?)\n\};`
  ).exec(parser);
  if (!set) throw new Error(`src/parser.c has no character set of ${description}`);
  return [...set[1].matchAll(/\{(0x[0-9a-f]+), (0x[0-9a-f]+)\}/g)].map(([, start, end]) => `    {${start}, ${end}},`);
}

const letters = nonAsciiRanges(`{'A', 'Z'}, {'_', '_'}, {'a', 'z'}`, '[A-Z_a-z] and non-ASCII letters');
const nameParts = nonAsciiRanges(
  `{'0', '9'}, {'A', 'Z'}, {'_', '_'}, {'a', 'z'}`,
  '[0-9A-Z_a-z] and non-ASCII letters and digits'
);

fs.writeFileSync(
  path.join(src, 'letter_ranges.h'),
  `// Generated by script/generate-letter-ranges from src/parser.c; do not edit.

#ifndef TREE_SITTER_KOTLIN_LETTER_RANGES_H_
#define TREE_SITTER_KOTLIN_LETTER_RANGES_H_

#include <stdint.h>

// The non-ASCII code points of Unicode letters (\\p{L}), as sorted inclusive ranges.
static const uint32_t LETTER_RANGES[][2] = {
${letters.join('\n')}
};

// The non-ASCII code points of Unicode letters and decimal digits (\\p{L} and \\p{Nd}), as sorted inclusive ranges.
static const uint32_t NAME_PART_RANGES[][2] = {
${nameParts.join('\n')}
};

#endif
`
);
