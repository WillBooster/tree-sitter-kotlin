#!/usr/bin/env node
// Writes src/letter_ranges.h, the non-ASCII code point ranges of the letters that may start an identifier in a string
// template, for the external scanner. They are copied from the character set that `tree-sitter generate` wrote into
// src/parser.c for that token (`[\p{L}_]`), so that both agree on the Unicode version.

const fs = require('node:fs');
const path = require('node:path');

const src = path.join(__dirname, '..', 'src');
const parser = fs.readFileSync(path.join(src, 'parser.c'), 'utf8');
const set = /static const TSCharacterRange \w+\[\] = \{\n  \{'A', 'Z'\}, \{'_', '_'\}, \{'a', 'z'\}, ([^;]*?)\n\};/.exec(
  parser
);
if (!set) throw new Error('src/parser.c has no character set of [A-Z_a-z] and non-ASCII letters');
const ranges = [...set[1].matchAll(/\{(0x[0-9a-f]+), (0x[0-9a-f]+)\}/g)].map(([, start, end]) => `    {${start}, ${end}},`);

fs.writeFileSync(
  path.join(src, 'letter_ranges.h'),
  `// Generated by script/generate-letter-ranges from src/parser.c; do not edit.

#ifndef TREE_SITTER_KOTLIN_LETTER_RANGES_H_
#define TREE_SITTER_KOTLIN_LETTER_RANGES_H_

#include <stdint.h>

// The non-ASCII code points of Unicode letters (\\p{L}), as sorted inclusive ranges.
static const uint32_t LETTER_RANGES[][2] = {
${ranges.join('\n')}
};

#endif
`
);
