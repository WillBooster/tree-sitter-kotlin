#!/usr/bin/env node
// Writes src/letter_ranges.h, the code point ranges of Unicode letters (\p{L}) by the Unicode version of this Node.js,
// for the external scanner, which the C library cannot tell them.

const fs = require('node:fs');
const path = require('node:path');

const ranges = [];
let start = -1;
for (let codePoint = 0x80; codePoint <= 0x110000; codePoint++) {
  const letter = codePoint <= 0x10ffff && /\p{L}/u.test(String.fromCodePoint(codePoint));
  if (letter && start < 0) start = codePoint;
  if (!letter && start >= 0) {
    ranges.push(`    {0x${start.toString(16)}, 0x${(codePoint - 1).toString(16)}},`);
    start = -1;
  }
}

const header = `// Generated by script/generate-letter-ranges from Unicode ${process.versions.unicode}; do not edit.

#ifndef TREE_SITTER_KOTLIN_LETTER_RANGES_H_
#define TREE_SITTER_KOTLIN_LETTER_RANGES_H_

#include <stdint.h>

// The non-ASCII code points of Unicode letters (\\p{L}), as sorted inclusive ranges.
static const uint32_t LETTER_RANGES[][2] = {
${ranges.join('\n')}
};

#endif
`;
fs.writeFileSync(path.join(__dirname, '..', 'src', 'letter_ranges.h'), header);
